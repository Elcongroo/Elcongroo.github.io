---
import Base from '../layouts/Base.astro';
import PostRow from '../components/PostRow.astro';
import Status from '../components/Status.astro';
import StreamEvidence from '../components/StreamEvidence.astro';
import PerformanceMap from '../components/PerformanceMap.astro';
import '../styles/home.css';
import { getCollection } from 'astro:content';
import { pathFor } from '../lib/paths';
import { categories, formatDate, site } from '../lib/site';
const posts=(await getCollection('posts',({data})=>!data.draft)).sort((a,b)=>Number(b.data.featured)-Number(a.data.featured)||b.data.updated.valueOf()-a.data.updated.valueOf()||a.data.seriesOrder-b.data.seriesOrder);
const firstPost=posts[0];
const corePosts=posts.filter(p=>p.data.journey&&p.id!==firstPost?.id).sort((a,b)=>a.data.journey!.order-b.data.journey!.order);
const supplements=posts.filter(p=>!p.data.journey&&p.id!==firstPost?.id);
const grouped=Object.entries(categories).map(([key,value])=>({key,...value,count:posts.filter(p=>p.data.category===key).length})).filter(c=>c.count>0);
const labs=(await getCollection('lab',({data})=>!data.draft)).sort((a,b)=>b.data.updated.valueOf()-a.data.updated.valueOf());
const latestLab=labs[0];
const basis=firstPost?.data.basis;
const basisHref=basis&&(/^https?:/.test(basis.href)?basis.href:pathFor(basis.href));
const [titleSubject,...titleRest]=firstPost?.data.title.split('：')??[];
---
<Base>
  <div class="shell journal-home">
    <header class="journal-intro">
      <div><h1>文章与实验</h1><p>Linux 内核 · IPsec / TLS · 高性能网络</p></div>
      <a class="journal-search" href={pathFor('articles/#search')}>检索文章 <span aria-hidden="true">↗</span></a>
    </header>
    <div class="journal-layout">
      <div class="journal-main">
        {firstPost&&<article class="featured-post">
          <div class="section-label"><span class="editorial-label">最近更新</span><span>{categories[firstPost.data.category].label} / {firstPost.data.kind}</span><time datetime={firstPost.data.updated.toISOString()}>{formatDate(firstPost.data.updated)}</time></div>
          <h2><a href={pathFor(`articles/${firstPost.id}/`)} aria-label={firstPost.data.title}><span class="title-subject">{titleSubject}{titleRest.length>0&&<span class="title-colon">：</span>}</span>{titleRest.length>0&&<span class="title-detail">{titleRest.join('：')}</span>}</a></h2>
          <div class:list={['featured-body', {'has-evidence':['tcp-recv-message-boundary','vpn-performance-profile'].includes(firstPost.id)}]}>
            <div class="featured-copy">
              <p class="featured-description">{firstPost.data.description}</p>
              {firstPost.data.takeaway&&<p class="featured-takeaway"><span>本文要点</span>{firstPost.data.takeaway}</p>}
              <a class="feature-read" href={pathFor(`articles/${firstPost.id}/`)}>阅读全文 <span aria-hidden="true">↗</span><small>约 {firstPost.data.minutes} 分钟</small></a>
            </div>
            {firstPost.id==='tcp-recv-message-boundary'&&<StreamEvidence/>}
            {firstPost.id==='vpn-performance-profile'&&<PerformanceMap/>}
          </div>
          <div class="featured-footnote"><Status state={firstPost.data.conclusion}/>{basis&&<a href={basisHref}>{basis.label} ↗</a>}</div>
          {basis&&<p class="featured-boundary">{basis.boundary}</p>}
        </article>}
        {corePosts.length>0&&<section class="journal-entries" aria-labelledby="more-writing">
          <div class="section-heading"><h2 id="more-writing">沿着一条安全通信链路</h2><a href={pathFor('journey/')}>按顺序读 <span aria-hidden="true">↗</span></a></div>
          <p class="series-introduction">从入职这一起点回看，经过内核、隧道与协议，再回到上面的性能问题。日期为回溯编排，文章于 2026-09-29 整理公开。</p>
          {corePosts.map(post=><PostRow post={post} compact/>)}
        </section>}
        {supplements.length>0&&<section class="supplemental-reading" aria-labelledby="supplement-title"><div class="section-heading"><h2 id="supplement-title">旁支与小实验</h2><a href={pathFor('articles/')}>全部 {posts.length} 篇 ↗</a></div><ul>{supplements.map(post=><li><span>{post.data.kind}</span><a href={pathFor(`articles/${post.id}/`)}>{post.data.title} ↗</a></li>)}</ul></section>}
      </div>
      <aside class="journal-aside">
        <section class="author-note">
          <h2>关于作者</h2><p class="author-name" lang="en">congroo</p>
          <p>一名从事密码网关研发的工程师。关注 Linux 内核、高性能网络与 IPsec / TLS。</p>
          <p>顺着包的路径读源码，再把状态、密钥与测量结果对起来。这里也留着暂时没弄清的问题。</p>
          <a href={pathFor('about/')}>关于我与这个博客 ↗</a>
          <div class="author-links"><a href={site.github}>GitHub ↗</a><a href={pathFor('subscribe/')}>RSS ↗</a></div>
        </section>
        <section class="topic-index"><h2>按主题阅读</h2><ul>{grouped.map(c=><li><a href={pathFor(`articles/?category=${c.key}`)}><span>{c.label}</span><span>{String(c.count).padStart(2,'0')}</span></a></li>)}</ul></section>
        <section class="journey-margin"><h2>从 7 月 15 日开始</h2><p>内核是底座，IPsec / TLS 是通信主线，性能是继续往下追的问题。</p><a href={pathFor('journey/')}>七篇文章的回溯阅读线 ↗</a></section>
        {latestLab&&<section class="lab-margin"><h2>实验手记</h2><p class="margin-meta"><span>{latestLab.data.number}</span><time datetime={latestLab.data.updated.toISOString()}>{formatDate(latestLab.data.updated)}</time></p><h3><a href={pathFor(`lab/${latestLab.id}/`)}>{latestLab.data.title} ↗</a></h3><p class="open-question"><span>尚待验证</span>{latestLab.data.openQuestions[0]}</p></section>}
        <section class="editorial-note"><h2>阅读说明</h2><p><span class="status-key verified-key">实验</span>标明执行者、环境与原始输出。</p><p><span class="status-key reference-key">资料</span>区分标准、源码分析与推测。</p><a href={pathFor('about/#editorial')}>内容与修订原则 ↗</a></section>
      </aside>
    </div>
  </div>
</Base>
