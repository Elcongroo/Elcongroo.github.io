---
import Base from '../../layouts/Base.astro';
import Status from '../../components/Status.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { formatDate, site, categories } from '../../lib/site';
import { pathFor } from '../../lib/paths';
export async function getStaticPaths(){return (await getCollection('posts',({data})=>!data.draft)).map(post=>({params:{id:post.id},props:{post}}));}
interface Props { post: CollectionEntry<'posts'>; }
const {post}=Astro.props;
const [titleSubject,...titleRest]=post.data.title.split('：');
const basis=post.data.basis;
const basisHref=basis&&(/^https?:/.test(basis.href)?basis.href:pathFor(basis.href));
const {Content,headings}=await render(post);
const all=(await getCollection('posts',({data})=>!data.draft)).sort((a,b)=>Number(!!b.data.journey)-Number(!!a.data.journey) || (a.data.journey?.order??0)-(b.data.journey?.order??0) || a.data.date.valueOf()-b.data.date.valueOf() || a.id.localeCompare(b.id));
const index=all.findIndex(p=>p.id===post.id);
const previous=all[index-1]; const next=all[index+1];
const series=all.filter(p=>p.data.series===post.data.series).sort((a,b)=>a.data.seriesOrder-b.data.seriesOrder);
const structured={ '@context':'https://schema.org','@type':'BlogPosting',headline:post.data.title,description:post.data.description,datePublished:post.data.date.toISOString(),dateModified:post.data.updated.toISOString(),author:{'@type':'Person',name:site.author},mainEntityOfPage:new URL(Astro.url.pathname,Astro.site).href};
---
<Base title={post.data.title} description={post.data.description} article>
  <div class="reading-shell">
    <header class="article-header"><div class="breadcrumb"><a href={pathFor('articles/')}>文章</a> / {categories[post.data.category].label}</div><div class="entry-meta"><span>{post.data.kind}</span><span>{post.data.difficulty}</span><span>约 {post.data.minutes} 分钟</span><Status state={post.data.conclusion} full/></div><h1 data-pagefind-meta="title" aria-label={post.data.title}><span class="article-title-part">{titleSubject}{titleRest.length>0&&<span class="article-title-colon">：</span>}</span>{titleRest.length>0&&<span class="article-title-part">{titleRest.join('：')}</span>}</h1><p class="article-byline">congroo · 发布于 <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time> · 修订于 <time datetime={post.data.updated.toISOString()}>{formatDate(post.data.updated)}</time></p><p class="article-journey" data-pagefind-ignore hidden={!post.data.journey}>{post.data.journey&&<><a href={pathFor('journey/')}>阅读主线 · 第 {post.data.journey.order} 篇</a> · 回溯坐标 {formatDate(post.data.journey.date)}<span>按入职后的研究主题回溯编排；坐标不代表当日写作或发表，真实公开日期见上。</span></>}</p><p class="summary"><strong>摘要：</strong>{post.data.description}</p><dl class="article-reading-guide">{post.data.takeaway&&<div><dt>要点</dt><dd>{post.data.takeaway}</dd></div>}{basis&&<div><dt>依据</dt><dd><a href={basisHref}>{basis.label}</a><span class="guide-boundary">{basis.boundary}</span></dd></div>}</dl></header>
    <details class="article-conditions"><summary>环境、版本与验证范围</summary><dl class="article-meta"><div><dt>发布 / 修订</dt><dd><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time> / <time datetime={post.data.updated.toISOString()}>{formatDate(post.data.updated)}</time></dd></div><div><dt>所属系列</dt><dd>{post.data.series} · {String(post.data.seriesOrder).padStart(2,'0')}</dd></div><div><dt>前置知识</dt><dd>{post.data.prerequisites.join('；')}</dd></div><div><dt>适用版本</dt><dd>{post.data.software.join('；')}</dd></div><div><dt>实验环境</dt><dd>{post.data.environment.join('；')}</dd></div><div><dt>验证与执行</dt><dd>{post.data.verificationActor}</dd></div><div><dt>代码仓库</dt><dd>{post.data.repository ? <a href={post.data.repository}>对应仓库</a> : '尚无独立公开仓库；有脚本时见文末原始材料。'}</dd></div></dl></details>
    <div class="article-layout">
      <article class="prose" data-pagefind-body>
        <Content/>
        {post.data.evidence.length>0&&<section aria-labelledby="evidence-title"><h2 id="evidence-title">原始材料</h2><ul class="evidence-list">{post.data.evidence.map(e=><li><a href={pathFor(e.path)}>{e.label}</a></li>)}</ul></section>}
        <section class="article-updates" data-pagefind-ignore><h2>更新记录</h2>{post.data.changes.map(c=><div><time datetime={c.date.toISOString()}>{formatDate(c.date)}</time><p>{c.note}</p></div>)}</section>
        <nav class="series-nav" aria-label="系列导航" data-pagefind-ignore><strong>系列 / {post.data.series}</strong><ol>{series.map(p=><li><a href={pathFor(`articles/${p.id}/`)} aria-current={p.id===post.id?'page':undefined}>{p.data.title}</a></li>)}</ol></nav>
        <nav class="article-pagination" aria-label="相邻文章" data-pagefind-ignore>{previous?<a href={pathFor(`articles/${previous.id}/`)}><span>上一篇</span>{previous.data.title}</a>:<div/>}{next?<a href={pathFor(`articles/${next.id}/`)}><span>下一篇</span>{next.data.title}</a>:<a href={pathFor('articles/')}><span>继续阅读</span>返回文章目录</a>}</nav>
      </article>
      <aside class="article-aside" data-pagefind-ignore><details class="toc" open><summary>本文目录 / CONTENTS</summary><nav aria-label="文章目录">{headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}</nav></details><div class="margin-note"><strong>阅读边注</strong><p>{post.data.realVerified ? '验证标记对应本文列出的环境和用例，不自动扩展到产品、作者掌握程度或其他协议。' : '本文属于公开资料阅读稿。机制解释与本机实测是两种材料，不应互相替代。'}</p></div></aside>
    </div>
  </div>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structured).replaceAll('<','\u003c')}/>
  <script>if(window.matchMedia('(max-width: 760px)').matches)document.querySelector('.toc')?.removeAttribute('open');</script>
</Base>
