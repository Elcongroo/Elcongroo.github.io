---
import type { CollectionEntry } from 'astro:content';
import { formatDate, categories } from '../lib/site';
import { pathFor } from '../lib/paths';
import Status from './Status.astro';
interface Props { post: CollectionEntry<'posts'>; number?: number; }
const { post } = Astro.props;
---
<article class="post-row">
  <div class="post-time"><time datetime={post.data.updated.toISOString()}>{formatDate(post.data.updated)}</time><span>{post.data.kind}</span></div>
  <div class="post-content"><h3><a href={pathFor(`articles/${post.id}/`)}>{post.data.title}</a></h3><p>{post.data.description}</p><div class="entry-meta"><span>{categories[post.data.category].label}</span><span>{post.data.difficulty}</span><span>约 {post.data.minutes} 分钟</span><Status state={post.data.conclusion}/></div></div>
</article>
