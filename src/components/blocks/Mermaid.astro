---
import { renderProtocolDiagram } from '../../../scripts/render-protocol-diagram.mjs';
interface Props { source: string; caption: string; }
const { source, caption } = Astro.props;
// Build-time rendering: no diagram library is sent to the browser.
const svg = renderProtocolDiagram(source);
---
<figure class="protocol-figure"><div class="diagram-viewport" role="img" aria-label={caption} tabindex="0" set:html={svg}/><figcaption>{caption}</figcaption><details class="diagram-source" data-pagefind-ignore><summary>查看图示源文本</summary><pre><code>{source}</code></pre></details></figure>
